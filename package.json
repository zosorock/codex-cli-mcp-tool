{
  "name": "codex-cli-mcp-tool",
  "version": "1.0.10",
  "description": "MCP server for OpenAI Codex CLI integration",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "codex-cli-mcp-tool": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "postbuild": "chmod +x dist/index.js",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "test": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "codex",
    "openai",
    "cli",
    "ai",
    "llm"
  ],
  "author": "Mr-Tomahawk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mr-Tomahawk/codex-cli-mcp-tool.git"
  },
  "bugs": {
    "url": "https://github.com/Mr-Tomahawk/codex-cli-mcp-tool/issues"
  },
  "homepage": "https://github.com/Mr-Tomahawk/codex-cli-mcp-tool#readme",
  "engines": {
    "node": ">=20.19.0"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.28.0",
    "chalk": "^5.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
